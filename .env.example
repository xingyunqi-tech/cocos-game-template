# 复制为 .env.local 后填写；.env.local 不入库
WECHAT_APPID=
DOUYIN_APPID=
# 上传：微信代码上传密钥文件路径、抖音上传 token
WECHAT_UPLOAD_KEY=
DOUYIN_UPLOAD_TOKEN=
# 远程资源：服务器地址（构建注入）与上传命令（{dir} 替换为 remote 目录，不需要再加引号）
REMOTE_SERVER=
REMOTE_UPLOAD_COMMAND=
# 本机工具路径，默认位置之外时填写：Creator（macOS 指向 .app，Windows 指向 CocosCreator.exe）、smoke:web 使用的 Chrome
COCOS_CREATOR_APP=
CHROME_PATH=
